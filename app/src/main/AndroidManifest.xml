<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Deliberately no INTERNET permission. Signing keys cannot leave the device even if the app
        is compromised, and update detection needs no network: it compares the version of an
        installed app against the version its clone was built from, both read locally.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Listing apps to clone, and noticing when one of them is updated. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Handing a finished clone to the package installer session. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Repacking and signing a large APK outlives a trip to the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.strongbox_keystore"
        android:required="false" />

    <application
        android:name=".AppClonerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:memtagMode="async"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCloner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AppCloner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Accept an APK opened with, or shared to, this app. Both filters are narrowed to the
                APK media type so the app does not volunteer itself for unrelated files, and the
                handler ignores anything that is not a content:// URI.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!--
            Holds the process up while a clone is being built. It carries no key material: the
            pipeline runs in the application scope and this only publishes progress.
        -->
        <service
            android:name=".clone.CloneJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Rewrites dex files for deep rename in a process of its own. The object model of one
            large dex can take most of the heap a phone allows an app; here it gets all of that,
            and running out of it ends this process instead of the one drawing the screen. Not
            isolatedProcess: it reads the source APKs and writes into the app's own files.
        -->
        <service
            android:name=".clone.DexWorkerService"
            android:exported="false"
            android:process=":dex" />

        <receiver
            android:name=".clone.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
